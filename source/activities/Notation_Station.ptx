<section xml:id="elab">
    <title>Notation Elaboration</title>
    <exercise>
        <p>
                   Use Station 1 to write a problem with <m>a^0</m> as the answer.

        </p> 
    </exercise>

    <exercise>
       <p> Use 
        Station 1 to write a problem with <m>a^{-2}</m> as the answer.</p>
    </exercise>
    <exercise>
        <p>Use 
        Station 2 to write a problem with <m>a^0</m> as the answer.</p>
    </exercise>

    <exercise >
       <p> Use 
        Station 2 to write a problem with <m>a^{-2}</m> as the answer.</p>
    </exercise>
    <exercise >
     
       <p> What familiar operation is  <m>a^{\frac{1}{2}}</m>? similarly for <m>a^{\frac{1}{3}}</m>?</p>
    </exercise>

    <exercise>
         <introduction><p>
            Evaluate the following:
        </p> </introduction>
        <task>
            <statement>
                <p>
                    <m>2^x\cdot 2^2=</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>2^{2x}/ 2^3=</m>
                </p>
            </statement>
        </task>

        <task>
            <statement>
                <p>
                    <m>\left(2^{5x+15}\right)^{\frac{2}{5}}=</m>
                </p>
            </statement>
        </task>
    </exercise>
</section>

