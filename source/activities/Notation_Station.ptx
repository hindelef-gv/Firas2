<definition xml:id="defd">
  <statement>
    <p>
     When we divide  exponents with the same base, we subtract the powers keeping the same base.
     <md>
      2^a/ 2^b=2^{a-b}
     </md>
      
    </p>
  </statement>
</definition>

<exercise>
    <introduction>
    <p>
      Use the result in Station 2 to evaluate the expressions below
    </p>
    </introduction>
    
  <task>
    
      <p>
        <m>2^3/ 2^3=</m>
      </p>
  
  </task>

  <task>
    
      <p>
        <m>2^5/ 2^4=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>2^3/ 2^4=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>2/ 2^{\frac{1}{2}}=</m>
      </p>
  
  </task>
  <task>
    
      <p>
       <m>3^{\frac{9}{2}}/ 3^{\frac{7}{2}}=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>x^{\frac{3}{2}}/ x^{\frac{1}{8}}=</m>
      </p>
  
  </task>
</exercise>
