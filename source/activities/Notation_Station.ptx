<definition xml:id="defm">
  <statement>
    <p>
     When we multiply exponents with the same base, we add the powers keeping the same base.
     <md>
      2^a\cdot 2^b=2^{a+b}
     </md>
      
    </p>
  </statement>
</definition>

<exercise>
    <introduction>
    <p>
      Use the result in Station 1 to evaluate the expressions below
    </p>
    </introduction>
    
  <task>
    
      <p>
        <m>2^0\cdot2^3=</m>
      </p>
  
  </task>

  <task>
    
      <p>
        <m>2^0\cdot 2^4=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>2^0\cdot 2^x=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>2^{\frac{1}{2}}\cdot 2^{\frac{1}{2}}=</m>
      </p>
  
  </task>
  <task>
    
      <p>
       <m>3^{\frac{1}{2}}\cdot 3^{\frac{1}{2}}=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>x^{\frac{1}{2}}\cdot x^{\frac{1}{2}}=</m>
      </p>
  
  </task>
</exercise>
