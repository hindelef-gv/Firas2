<section><title>Station 3</title>

<definition xml:id="defneg">
  <statement>
    <p>
     A negative in the exponent means a reciprocal.
     <md>
       2^{-a}=\frac{1}{2^{a}} \mbox{ and }\frac{1}{2^{-a}}=2^a
     </md>
      
    </p>
  </statement>
</definition>


<exercise>
    <introduction>
    <p>
      Use the result in Station 3 to evaluate the expressions below
    </p>
    </introduction>
    
  <task>
    
      <p>
        <m>\displaystyle\frac{2^6\cdot 3^2}{2^2\cdot 3^6}=</m>
      </p>
  
  </task>

  <task>
    
      <p>
        <m>\displaystyle\frac{x^{10}\cdot y^{33}}{y^{35}\cdot x^{15}}=</m>
      </p>
  
  </task>
  
</exercise>





    </section>

<section xml:id="Sec4">
    <title>Station 4</title>
    
    <definition xml:id="def_frac">
  <statement>
    <p>
     A fraction (numerator over denominator) in the exponent means that the denominator is the index of a root.
     <md>
       2^{\frac{a}{b}}=\sqrt[b]{2^a} \mbox{ or }  2^{\frac{a}{b}}=\left(\sqrt[b]{2}\right)^a
     </md>
      
    </p>
  </statement>
</definition>

<exercise>
    <introduction>
    <p>
      Use the result in Station 4 to evaluate the expressions below
    </p>
    </introduction>
    <task>
        
    
      <p>
        <m>\displaystyle\left(\frac{2^6\cdot 3^2}{2^2\cdot 3^6}\right)^{\frac{1}{2}}=</m>
      </p>
  
  

    </task>
     <task>
        
    
      <p>
        <m>\displaystyle\left(\frac{y^{18}\cdot x^3}{x^9\cdot x^6}\right)^{\frac{2}{3}}=</m>
      </p>
  
  

    </task>
</exercise>
</section>
    
    
    
    
    
    
    
    
