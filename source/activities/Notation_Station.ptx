<definition xml:id="defe">
  <statement>
    <p>
     When we raise and exponential to an exponents, we ,multiply the exponents keeping the same base.
     <md>
      \left(2^a\right)^a=2^{a\cdot b}
     </md>
      
    </p>
  </statement>
</definition>

<exercise>
    <introduction>
    <p>
      Use the result in Station 5 to evaluate the expressions below
    </p>
    </introduction>
    
  <task>
    
      <p>
        <m>\left(2^{\frac{1}{2}}\right)^2=</m>
      </p>
  
  </task>

  <task>
    
      <p>
        <m>\left(2^{\frac{1}{3}}\right)^3=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>\left(2^{-2}\right)^4</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>\left(2^{-2}\right)^{-3}</m>
      </p>
  
  </task>
  <task>
    
      <p>
       <m>\left(3^{-4}\right)^{\frac{1}{2}}=</m>
      </p>
  
  </task>
  <task>
    
      <p>
        <m>\left(x^{4}\right)^3=</m>
      </p>
  
  </task>
</exercise>
