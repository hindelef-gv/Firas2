    <objectives>
    <ul>
      <li>Multiplication of Exponents Rules</li>
      <li>Division of Exponents Rules</li>
      <li>Negative Exponents</li>
      <li>Fractional Exponents</li>
      <li>Exponents of Exponents</li>

    </ul>
  </objectives>
