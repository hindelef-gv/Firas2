<exercise>
    <introduction>
        <p>
           For exponential functions of the form <m>f(x)=a \cdot b^x</m> 
        </p>
    </introduction>

    <task>
        <statement>
            <p>
                Describe the connection between the value of <m>a</m> and the graph.
            </p>
        </statement>
    </task>

    <task>
        <statement>
            <p>
              Bescribe the connection between the value of <m>b</m> and the graph.
            </p>
        </statement>
    </task>
</exercise>
</worksheet>
